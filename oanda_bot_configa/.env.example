# MS-ORB Config-A bot environment (forward test).
#
# IMPORTANT: use a SEPARATE OANDA practice sub-account for this bot. The base
# (ms-orb-oanda) and filtered (ms-orb-filtered) bots trade the same
# instruments; sharing an account would net positions across bots, corrupt
# startup position-adoption, and contaminate the forward-test measurement.
# Create a new practice account in the OANDA dashboard and put its ID here.

OANDA_API_KEY=your_api_key_here
OANDA_ACCOUNT_ID=your_SEPARATE_practice_account_id_here
OANDA_ENVIRONMENT=practice

# --- Config-A strategy parameters ---------------------------------------
# Every strategy parameter is pinned explicitly so an inherited shell env or
# stray .env can never change the strategy silently. These values MUST match
# `oanda_bot/backtest.py --config-a` (the validated configuration).
RISK_PER_TRADE=0.01
RR_TARGET=3.0
MAX_TRADES_PER_SESSION=1
ENABLED_SESSIONS=TOKYO
STOP_MODE=atr
ATR_STOP_MULT=1.5
ATR_PERIOD=14
HTF_ALIGN=true
HTF_EMA_PERIOD=100
FIRST_BREAKOUT_ONLY=true
INDICATOR_CANDLE_COUNT=1000

# --- Runtime -------------------------------------------------------------
PRICE_POLL_INTERVAL=10
LOG_LEVEL=INFO
