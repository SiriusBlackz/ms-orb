# MS-ORB cTrader bot environment (Config-A strategy on cTrader Open API).
#
# Setup order (see deploy/README_DEPLOY.md for the full walkthrough):
#   1. Create a cTrader ID at id.ctrader.com
#   2. Open a demo account at any cTrader broker (IC Markets demo is free)
#      — or later, the FTMO / FundingPips cTrader account.
#   3. Register an app at openapi.ctrader.com -> copy client ID + secret here.
#   4. Run `python3 get_token.py` once (interactive, needs a browser) ->
#      paste the two tokens below.
#   5. CTRADER_ACCOUNT_ID = the ctidTraderAccountId (printed by get_token.py).

CTRADER_CLIENT_ID=your_app_client_id
CTRADER_CLIENT_SECRET=your_app_client_secret
CTRADER_ACCESS_TOKEN=from_get_token_py
CTRADER_REFRESH_TOKEN=from_get_token_py
CTRADER_ACCOUNT_ID=your_ctidTraderAccountId
CTRADER_ENVIRONMENT=demo
# Refreshed tokens are persisted here (survives restarts; keep writable)
CTRADER_TOKEN_FILE=ctrader_tokens.json

# Internal instrument -> broker symbol name. Broker-specific!
# Check the bot's startup log ("Symbol resolved: ...") or the cTrader UI.
# FTMO commonly: XAUUSD + US100.cash ; IC Markets: XAUUSD + USTEC.
SYMBOL_MAP=XAU_USD=XAUUSD,NAS100_USD=US100

# --- Config-A strategy parameters ---------------------------------------
# Pinned explicitly; MUST match `oanda_bot/backtest.py --config-a`.
RISK_PER_TRADE=0.01
RR_TARGET=3.0
MAX_TRADES_PER_SESSION=1
ENABLED_SESSIONS=TOKYO
STOP_MODE=atr
ATR_STOP_MULT=1.5
ATR_PERIOD=14
HTF_ALIGN=true
HTF_EMA_PERIOD=100
FIRST_BREAKOUT_ONLY=true
INDICATOR_CANDLE_COUNT=1000

# --- Runtime -------------------------------------------------------------
PRICE_POLL_INTERVAL=10
LOG_LEVEL=INFO
