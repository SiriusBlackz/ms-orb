[Unit]
Description=MS-ORB Filtered OANDA Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=msorbbot
Group=msorbbot
WorkingDirectory=/opt/ms-orb-oanda-filtered
EnvironmentFile=/opt/ms-orb-oanda-filtered/.env

ExecStart=/opt/ms-orb-oanda-filtered/venv/bin/python3 main.py

# Logging
StandardOutput=append:/var/log/ms-orb-filtered.log
StandardError=append:/var/log/ms-orb-filtered.log

# Auto-restart on failure
Restart=on-failure
RestartSec=30

# Safety limits
MemoryMax=512M
CPUQuota=50%

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/ms-orb-oanda-filtered /var/log/ms-orb-filtered.log

[Install]
WantedBy=multi-user.target
