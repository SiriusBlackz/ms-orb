# MS-ORB IBKR Trading Bot Configuration
# Copy this file to .env and fill in your values

# ===== IBKR Connection =====
# IB Gateway (VPS): Paper=4002, Live=4001
# TWS (desktop):    Paper=7497, Live=7496
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1

# ===== Trading Parameters (Config A — must match backtest.py --config-a) =====
# Every strategy parameter is pinned explicitly so a stale .env can never
# silently run a hybrid config (e.g. ATR stop with 5:1).
RISK_PER_TRADE=0.01
RR_TARGET=3.0
MAX_TRADES_PER_SESSION=1
STOP_MODE=atr
ATR_STOP_MULT=1.5
ATR_PERIOD=14
HTF_ALIGN=true
HTF_EMA_PERIOD=100
FIRST_BREAKOUT_ONLY=true
INDICATOR_CANDLE_DURATION=20 D

# ===== Polling Settings =====
# Price polling interval in seconds
PRICE_POLL_INTERVAL=10

# ===== Logging =====
LOG_DIR=logs
LOG_LEVEL=INFO

# ===== Database =====
DB_PATH=ibkr_trades.db
